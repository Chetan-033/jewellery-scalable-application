# Local development — copy to .env (never commit .env)

ERP_PROFILE=offline
SERVER_PORT=18080
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=480

# Default offline uses H2 file DB. Example MySQL override:
# OFFLINE_JDBC_URL=jdbc:mysql://127.0.0.1:3306/jewellery_erp_tenant_demo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# OFFLINE_DB_USER=root
# OFFLINE_DB_PASSWORD=your_password
# OFFLINE_DB_DRIVER=com.mysql.cj.jdbc.Driver

# Online platform DB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PLATFORM_DB=jewellery_erp_platform
MYSQL_USER=erp_app
MYSQL_PASSWORD=change_me_local_only
