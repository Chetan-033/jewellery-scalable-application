# Local development — copy to .env (never commit .env)

ERP_PROFILE=online
SERVER_PORT=18080
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=480

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PLATFORM_DB=jewellery_erp_platform
MYSQL_USER=erp_app
MYSQL_PASSWORD=change_me_local_only

PLATFORM_ADMIN_USER=platform
PLATFORM_ADMIN_PASSWORD=Platform@123
